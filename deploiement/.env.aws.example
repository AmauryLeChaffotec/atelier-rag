# Copier à la racine du serveur AWS sous le nom .env.
ENVIRONNEMENT=production
FOURNISSEUR_IA=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING=text-embedding-3-small
OPENAI_GENERATION=gpt-4o-mini
# Facultatif : OCR des PDF, indépendant du chat et des embeddings OpenAI.
MISTRAL_API_KEY=
MISTRAL_OCR=mistral-ocr-latest
# Utiliser des secrets hexadécimaux générés par openssl rand -hex 32.
POSTGRES_PASSWORD=
CLE_ACCES=
DOMAINE=rag.votre-domaine.fr
EMAIL_TLS=votre-adresse@example.com
STOCKAGE=local
TAILLE_FICHIER_MO=15
MAX_CHUNKS=500
MAX_TOKENS_REPONSE=900
MAX_CONTEXTE_CARACTERES=16000
DELAI_IA_SECONDES=180
AWS_DEFAULT_REGION=eu-west-3
# Seulement si vous migrez plus tard vers S3 ou RDS :
S3_BUCKET=
# DATABASE_URL=postgresql://utilisateur:motdepasse@endpoint-rds:5432/atelier?sslmode=verify-full&sslrootcert=/certificats/rds.pem
