# LOCAL : aucune clé OpenAI nécessaire. Copier ce fichier vers .env.
FOURNISSEUR_IA=ollama
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING=qwen3-embedding:0.6b
OLLAMA_GENERATION=gemma4:e4b
OPENAI_API_KEY=
OPENAI_EMBEDDING=text-embedding-3-small
OPENAI_GENERATION=gpt-4o-mini
# OCR des PDF, uniquement sur demande dans le Studio. Laisser vide pour rester 100 % local.
MISTRAL_API_KEY=
MISTRAL_OCR=mistral-ocr-latest
POSTGRES_PASSWORD=atelier_local_uniquement
# DATABASE_URL se configure automatiquement dans Docker Compose.
# Hors Docker : postgresql://atelier:atelier_local_uniquement@127.0.0.1:5432/atelier
STOCKAGE=local
S3_BUCKET=
AWS_DEFAULT_REGION=eu-west-3
TAILLE_FICHIER_MO=15
MAX_CHUNKS=500
MAX_TOKENS_REPONSE=900
MAX_CONTEXTE_CARACTERES=16000
DELAI_IA_SECONDES=300
# Valeur optionnelle en local, obligatoire sur AWS (32 caractères minimum).
CLE_ACCES=
ENVIRONNEMENT=local
